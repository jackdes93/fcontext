.PHONY: run clean help

help:
	@echo "Job Hub + Worker Pool Example"
	@echo "=============================="
	@echo ""
	@echo "Commands:"
	@echo "  make run    - Chạy example"
	@echo "  make clean  - Xóa binaries"

run:
	@echo "🚀 Running Job Hub + Worker Pool Example..."
	@go run main.go

clean:
	@rm -f job-hub-worker-pool
	@echo "✨ Cleaned"
